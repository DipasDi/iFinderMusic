# ==============================================================================
# iFinderMusic - Environment Configuration
# ==============================================================================

# Telegram Bot Token obtained from @BotFather (Required)
BOT_TOKEN=your_telegram_bot_token_here

# Redis Connection Settings (Optional)
# If running with docker-compose, this is automatically configured.
REDIS_ADDR=127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_USER=default
REDIS_PASSWORD=

# Enable or disable persisting user IDs and usernames to JSON (Optional, default: true)
# Set to false to disable user tracking completely.
TRACK_USERS=true

# Path to the JSON file where user activity and statistics are stored (Optional, default: users.json)
USERS_FILE_PATH=users.json



